# ===== Copy to .env for real/demo secrets. NEVER commit .env =====

# --- Database (prod/demo = Supabase Postgres; local uses docker-compose defaults) ---
DATABASE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_USERNAME=postgres.<project-ref>
DATABASE_PASSWORD=

# --- JWT (REQUIRED, >= 32 bytes; generate: openssl rand -base64 48) ---
JWT_SECRET=

# --- Email: Brevo SMTP (demo) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@bookaura.local

# --- Google OAuth2 (P0-B; localhost callback URLs are fine for demo) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth2 (P0-B, lowest priority) ---
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
VITE_API_URL=/api
VITE_OAUTH_BASE_URL=http://localhost:8080

# --- Local admin seed (local profile only; never used in prod) ---
ADMIN_SEED_EMAIL=admin
ADMIN_SEED_PASSWORD=admin
